# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Public site URL: used for links in emails and vouchers
PUBLIC_SITE_URL=http://localhost:5173
# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind a reverse proxy / load balancer (IIS, Azure, nginx)
TRUST_PROXY=0
LOG_LEVEL=info

# ---------- Database (SQL Server) ----------
# msnodesqlv8 = Windows authentication via ODBC (local development on Windows)
# tedious     = SQL authentication over TCP (production, Azure SQL, Linux)
DB_DRIVER=msnodesqlv8
DB_NAME=MauriConnect
# msnodesqlv8 only
DB_ODBC_SERVER=localhost\SQLEXPRESS
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# tedious only
DB_SERVER=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# ---------- Security ----------
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
# Lifetime of the token issued after booking / lookup (minutes)
BOOKING_TOKEN_TTL_MINUTES=120
# Lifetime of the "manage your booking" link sent by email (days)
LINK_TOKEN_TTL_DAYS=60
# Key for internal/admin endpoints (manual refunds). Leave empty to disable them.
ADMIN_API_KEY=

# ---------- Payments ----------
# paypal = PayPal REST API (sandbox or live); fake = local simulator (never allowed in production)
PAYMENT_PROVIDER=paypal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the PayPal developer dashboard (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# ---------- Email ----------
# Leave SMTP_HOST empty in development: emails are written as .eml files to STORAGE_DIR/mail-preview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MauriConnect Car Rental <info@mauriconnect.com>"
# Receives a copy of every booking, cancellation and enquiry
OFFICE_EMAIL=info@mauriconnect.com

# ---------- Files & jobs ----------
STORAGE_DIR=./storage
# Development/demo only: show the sample star ratings loaded by npm run db:seed:dev.
# Refused when NODE_ENV=production.
SHOW_SAMPLE_REVIEWS=false
JOBS_ENABLED=true
